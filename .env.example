# Migdolus Monitor — variáveis de ambiente
# Copie para .env (dev). Em produção: /etc/avilaops/migdolus.env (chmod 600).

# Banco (PostGIS)
POSTGRES_DB=migdolus
POSTGRES_USER=migdolus
POSTGRES_PASSWORD=troque-me
DATABASE_URL=postgresql://migdolus:troque-me@localhost:5440/migdolus

# API
API_PORT=3070
API_PUBLIC_URL=https://migdolus.avilaops.com/api
JWT_SECRET=troque-me
JWT_TTL=15m
REFRESH_TTL=30d

# Painel
NEXT_PUBLIC_API_URL=https://migdolus.avilaops.com/api
NEXT_PUBLIC_MAP_STYLE=https://tiles.avilaops.com/styles/satelite.json

# Fotos e laudos (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=migdolus-fotos
R2_PUBLIC_BASE=

# Alertas (via n8n)
N8N_WEBHOOK_ALERTA_SEPTO=
N8N_WEBHOOK_LAUDO_PRONTO=

# Parâmetros agronômicos padrão (sobrescritos por organização)
DIAS_SEPTO=30
DIAS_SEPTO_AVISO=20
ESPACAMENTO_MALHA_M=30
