# Migdolus Monitor — painel + API (container migdolus-painel, 127.0.0.1:3070)
migdolus.avilaops.com {
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	# APK do app de campo — arquivo enviado por scp para /opt/migdolus/apk/migdolus-campo.apk
	handle_path /apk/* {
		root * /opt/migdolus/apk
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:3070
	}
}
