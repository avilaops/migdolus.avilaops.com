{
  "expo": {
    "name": "Migdolus Campo",
    "slug": "migdolus-campo",
    "version": "0.1.0",
    "scheme": "migdolus",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.avilaops.migdolus",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos o GPS para registrar a posição exata das armadilhas e das vistorias, mesmo sem sinal.",
        "NSCameraUsageDescription": "A câmera registra a foto da bacia com carimbo de data, hora e coordenadas."
      }
    },
    "android": {
      "package": "com.avilaops.migdolus",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0f1f17",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f1f17"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos o GPS para registrar a posição exata das armadilhas e das vistorias, mesmo sem sinal.",
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera registra a foto da bacia com carimbo de data, hora e coordenadas."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1f7a3e"
        }
      ],
      [
        "@maplibre/maplibre-react-native",
        {
          "android": {
            "locationEngine": "default"
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://migdolus.avilaops.com/api",
      "eas": {
        "projectId": ""
      }
    }
  }
}
